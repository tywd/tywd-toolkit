{
  "name": "vite-vue3-ts-template",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "serve": "vite preview",
    "lint": "eslint . && stylelint src/**/*.{css,scss,sass,less}",
    "lint:fix": "eslint --fix . && stylelint --fix src/**/*.{css,scss,sass,less}",
    "prepare": "husky install"
  },
  "dependencies": {
    "vue": "^3.2.0"
  },
  "devDependencies": {
    "@tywd/shared-configs": "workspace:*",
    "@vitejs/plugin-vue": "^3.0.0",
    "typescript": "^4.6.0",
    "vite": "^3.0.0",
    "vue-tsc": "^0.38.0",
    "eslint": "^8.0.0",
    "prettier": "^2.0.0",
    "stylelint": "^14.0.0",
    "commitlint": "^17.0.0",
    "husky": "^8.0.0",
    "lint-staged": "^13.0.0",
    "globals": "^13.0.0"
  }
}